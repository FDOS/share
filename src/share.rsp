system dos
debug DWARF
name share.com 
file startup,amisstub,sharetsr,sharemsg,messages,shareprg,tnyprntf,kitten,clib
option quiet,map,statics,verbose,artificial,symfile,NODEFAULTLIBS,start=entry
order 
  clname CODE segment _TEXT
  clname DATA
  clname BSS
  clname TCODE
  clname TDATA
  clname TBSS
  